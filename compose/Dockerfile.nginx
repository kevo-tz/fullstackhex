# Stage1: Builder - Build the Astro site (mirrors Dockerfile.frontend)
FROM oven/bun:1.4-slim@sha256:e0ee68d16ccb9927bf02aa7dd8fd4bf3369ee6d46da04faa72b05ce8bfd135f6 AS builder

WORKDIR /app

# Copy package files first (leverage Docker cache)
# Supports bun.lock (JSON) or bun.lockb (binary) — the RUN copies whichever exists
COPY frontend/package.json frontend/bun.lock* ./frontend/

# Install dependencies
RUN cd frontend && bun install --frozen-lockfile

# Copy source code
COPY frontend/ ./frontend/

# Build the Astro site
ARG PUBLIC_API_URL=https://api.example.com
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

RUN cd frontend && bun run build

# Stage2: Runtime - nginx serving static assets directly from disk
FROM nginx:1.31-alpine

COPY compose/nginx/nginx.conf /etc/nginx/nginx.conf

# Static assets baked into the image: built client output + public/ overrides
# (dist/client already includes public/ contents — favicons, styles/layout.css —
# so this second COPY is a safety net for files not copied by the Astro build)
COPY --from=builder /app/frontend/dist/client /usr/share/nginx/static
COPY --from=builder /app/frontend/public /usr/share/nginx/static

# nginx runs as uid 101 (user: "101" in prod.yml); ensure world-readability
RUN chmod -R a+rX /usr/share/nginx/static

# uid 101 needs writable cache and pid dirs to start
RUN mkdir -p /var/cache/nginx && chown -R 101:101 /var/cache/nginx /run

EXPOSE 80 443
